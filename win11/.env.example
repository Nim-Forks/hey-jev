# Copy to .env and fill in. .env values win over Credential Manager.

# Fish Audio is always required (TTS playback).
FISH_AUDIO_API_KEY=

# Decision backend — priority: KEV > Typesafe > OpenRouter-Jev.
# If KEV_URL AND KEV_API_KEY are both non-empty, decisions go to your KEV
# deployment instead (Jev-compatible contract); TYPESAFE_API_KEY is then unused.
# If NEITHER Typesafe NOR KEV is set, decisions run through OpenRouter's Jev
# (model typesafe/jev-1.13) using OPENROUTER_API_KEY — override with JEV_MODEL.
TYPESAFE_API_KEY=
KEV_URL=
KEV_API_KEY=
JEV_MODEL=typesafe/jev-1.13

# Optional: LLM answers for questions ("who wrote Hamlet"); also the
# OpenRouter-Jev decision fallback when Typesafe/KEV are absent
OPENROUTER_API_KEY=
# LLM used for spoken answers (default claude-haiku). Override freely:
LLM_MODEL=anthropic/claude-haiku-4.5
# Headroom for reasoning models (GLM et al need more than the bare answer)
LLM_MAX_TOKENS=300

# Remote mic/PTT web server (python siri.py --remote).
# REMOTE_FRONT: none | npm | coolify | tunnel (fronts are proxies; the
# server itself always binds plain HTTP on REMOTE_PORT and fronts can
# run simultaneously). REMOTE_TOKEN: shared secret; if set, web clients
# need it (Settings page) or their own keys.
REMOTE_FRONT=none
REMOTE_PORT=8765
REMOTE_HOST=0.0.0.0
REMOTE_TOKEN=
# Free turns a client gets when it uses the server's own keys (counted in
# the client's localStorage; turns with the client's own Fish key don't count)
SERVER_KEY_LIMIT=10

# Optional: phone push for timer/reminder alerts via ntfy.sh
# (e.g. NTFY_URL=https://ntfy.sh/your-secret-topic — pick an unguessable
# topic name; anyone who knows it can see your notifications)
NTFY_URL=
# Default spoken/pushed alert for timers set without a label
# (labeled reminders say their label; per-device override in Settings)
ALERT_MESSAGE=
