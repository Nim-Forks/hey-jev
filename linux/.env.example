# Copy to .env and fill in. Variable names are identical to the Windows port —
# you can copy win11/.env and adjust REMOTE_* / NTFY_URL.
# Reference: doc/linux/03-api-keys.md

# Decision backend — priority: KEV > Typesafe > OpenRouter-Jev
KEV_URL=
KEV_API_KEY=
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13

# LLM answers
LLM_MODEL=anthropic/claude-haiku-4.5
LLM_MAX_TOKENS=300

# Fish Audio (always required — the voice)
FISH_AUDIO_API_KEY=

# Remote server
REMOTE_FRONT=tunnel
REMOTE_PORT=8765
REMOTE_HOST=127.0.0.1
REMOTE_TOKEN=
SERVER_KEY_LIMIT=10

# Phone push (ntfy topic — unguessable name, that name IS the password)
NTFY_URL=
# Default spoken/pushed alert for label-less timers
ALERT_MESSAGE=

# Confidence gate (0.45 default with KEV, 0.65 otherwise)
# JEV_GATE=0.45

# STT languages (comma list). Any non-English entry switches Whisper to the
# multilingual 'small' model (~470 MB, downloaded by install.sh) and
# auto-detects the spoken language. Empty/EN-only uses small.en (~250 MB).
WHISPER_LANGUAGES=en
