# Copy to .env and fill in. Variable names identical to win11/linux.
# Reference: ../win11/doc/03-api-keys.md

# Decision backend — priority: KEV > Typesafe > OpenRouter-Jev
KEV_URL=
KEV_API_KEY=
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13

# LLM answers
LLM_MODEL=anthropic/claude-haiku-4.5
LLM_MAX_TOKENS=300

# Fish Audio (always required — the voice)
FISH_AUDIO_API_KEY=

# Remote server
REMOTE_FRONT=none
REMOTE_PORT=8765
REMOTE_HOST=0.0.0.0
REMOTE_TOKEN=
# REMOTE_TOKENS: extra tokens, comma-separated — hand one per device,
# revoke a device by deleting its token here (then restart the server)
REMOTE_TOKENS=
SERVER_KEY_LIMIT=10

# Phone push (ntfy topic — unguessable name)
NTFY_URL=
# Default spoken/pushed alert for label-less timers
ALERT_MESSAGE=

# STT languages (comma list; non-English entries need the multilingual model)
WHISPER_LANGUAGES=en
